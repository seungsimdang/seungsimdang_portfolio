{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "plugins": [
    {
      "path": "./plugins/korean-test-titles.grit",
      "includes": [
        "tests/**/*.spec.*",
        "tests/**/*.test.*",
        "__tests__/**/*.test.ts"
      ]
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "tests/**",
      "*.ts",
      "*.mjs",
      "package.json",
      "tsconfig.json",
      "biome.json",
      "!!**/next-env.d.ts",
      "scripts/**",
      "docs/agent-harness/manifest.json",
      "knip.json",
      "src/**",
      "__tests__/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
