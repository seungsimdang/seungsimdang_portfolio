# Neon Postgres 연결 문자열, 빌드(정적 생성)와 런타임, 마이그레이션에 필요
DATABASE_URL=

# e2e 테스트 전용 DB (Neon e2e 브랜치), pnpm db:seed:e2e와 pnpm test:e2e:local에서 사용
E2E_DATABASE_URL=

# next-auth JWT 서명 키 (openssl rand -base64 32)
NEXTAUTH_SECRET=

# 콜백 기준 URL, 로컬은 http://localhost:3000, Production은 배포 도메인
NEXTAUTH_URL=http://localhost:3000

# admin 쓰기 요청의 Origin으로 추가 허용할 host, 쉼표 구분 (예: www.example.com,example.com), www/apex 별칭 등에 사용, 선택
ADMIN_ALLOWED_HOSTS=

# GitHub OAuth App (환경별로 분리 생성, Preview에서는 admin 로그인 미지원)
GITHUB_ID=
GITHUB_SECRET=

# admin으로 허용할 GitHub 숫자 user id, 여러 명이면 쉼표 구분, 비어 있으면 모든 로그인 거부
ADMIN_GITHUB_ID=
