# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scaffold
!.env.example
/playwright-report/
/test-results/
/.pnpm-store/

# agent scratch files
/artifacts/archive/
/artifacts/scaffolding/

/.claude/worktrees/
/.codex/worktrees/

# QA 화면 캡처는 재실행으로 다시 생성
artifacts/task-team/*/qa-screens/
