{
  "name": "seungsimdang_portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/check-upload-env.mjs && next dev",
    "build": "node --env-file-if-exists=.env.local scripts/check-upload-env.mjs && node --env-file-if-exists=.env.local scripts/migrate.mjs --build && node -e \"require('fs').rmSync('.next/cache/fetch-cache',{recursive:true,force:true})\" && next build",
    "start": "next start",
    "lint": "biome lint .",
    "check": "biome check .",
    "format": "biome format --write .",
    "type-check": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "verify": "pnpm harness:check && pnpm harness:test && pnpm knip && pnpm check && pnpm type-check && pnpm test:e2e:local",
    "harness:sync": "node scripts/sync-agent-harness.mjs --write",
    "harness:check": "node scripts/sync-agent-harness.mjs --check",
    "harness:test": "vitest run --config __tests__/lint/vitest.lint.config.ts",
    "prepare": "husky",
    "lint:staged": "lint-staged --relative --concurrent false",
    "knip": "knip",
    "react-doctor": "react-doctor --verbose --yes --no-telemetry",
    "react-doctor:staged": "sh scripts/check-react-doctor-staged.sh",
    "test": "vitest run",
    "check:upload-env": "node --env-file-if-exists=.env.local scripts/check-upload-env.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:resume:seed": "tsx --env-file-if-exists=.env.local scripts/resume-data.ts seed",
    "db:resume:profile": "tsx --env-file-if-exists=.env.local scripts/resume-data.ts profile",
    "blog:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate-blog.ts",
    "db:seed:e2e": "tsx --env-file-if-exists=.env.local tests/e2e/fixtures/seed.ts",
    "test:e2e:local": "sh scripts/run-e2e-local.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@neondatabase/serverless": "1.2.0",
    "@suspensive/react-query-5": "3.21.4",
    "@tanstack/react-query": "5.104.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "2.3.3",
    "@vercel/speed-insights": "2.0.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "hast-util-to-jsx-runtime": "2.3.6",
    "next": "16.3.8",
    "next-auth": "4.24.15",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "rehype-highlight": "7.0.2",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "knip": "6.38.0",
    "lint-staged": "17.5.1",
    "react-doctor": "0.9.14",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.22.1 <25",
    "pnpm": ">=11 <12"
  },
  "type": "module"
}
